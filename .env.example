# PolyAero Cathay SmartTag Environment Configuration
# Mobile loads apps/mobile/.env; use that app's .env.example or .env.production.example.
# Staff environment configuration is separate and unchanged.

# Mobile App (Expo Public - anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_USE_MOCK_DATA=false

# Ground Staff Portal (Next.js - anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_USE_MOCK_DATA=true

# Server-only secrets (Never expose to mobile or browser client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
