# PolyAero Cathay SmartTag Environment Configuration
# Note: For hackathon local development, all apps run out-of-the-box using built-in mock data.
# When ready to test with live Supabase, copy this file to .env.local

# Mobile App (Expo Public - anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_USE_MOCK_DATA=true

# Ground Staff Portal (Next.js - anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_USE_MOCK_DATA=true

# Server-only secrets (Never expose to mobile or browser client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
