# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smarttag
# Set to the AWS RDS CA bundle path for verified cloud database TLS.
DATABASE_SSL_CA_FILE=

# App
APP_NAME=PolyAero Cathay SmartTag API
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:8081

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","exp://localhost:8081"]

# Auth (local development only; replace with a random secret before deployment)
SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Verification codes
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email verification (implicit TLS SMTP; Gmail app password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_APP_PASSWORD=

# WebAuthn / passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PolyAero Cathay SmartTag
WEBAUTHN_ORIGIN=http://localhost:8081

# Server-only staff credential for PATCH /flights/{id}/status. Empty disables updates.
# Configure securely; never put this credential in EXPO_PUBLIC_* or the mobile app.
FLIGHT_STATUS_STAFF_KEY=

# Server-only shared device key for IoT taps. Empty leaves the demo gate disabled.
# Provision privately to trusted hardware; never include in frontend public variables.
IOT_DEVICE_KEY=

# Optional seed password: set SEED_USER_PASSWORD privately in your shell before
# the first `uv run python -m app.seed --apply`. Reruns do not reset passwords.
# Isolated PostgreSQL tests use SEED_TEST_DATABASE_URL=postgresql+psycopg://...
# Do not point test or seed commands at production.
