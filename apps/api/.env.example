# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smarttag
# Set to the AWS RDS CA bundle path for verified cloud database TLS.
DATABASE_SSL_CA_FILE=

# App
APP_NAME=PolyAero Cathay SmartTag API
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:8081

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","exp://localhost:8081"]

# Auth
SECRET_KEY=dev-secret-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Verification codes
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email verification (Gmail API via OAuth refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# WebAuthn / passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PolyAero Cathay SmartTag
WEBAUTHN_ORIGIN=http://localhost:8081
