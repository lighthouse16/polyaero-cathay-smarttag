{
  "expo": {
    "name": "PolyAero SmartTag",
    "slug": "polyaero-smarttag",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "polyaero-smarttag",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polyaero.smarttag",
      "infoPlist": {
        "NFCReaderUsageDescription": "PolyAero SmartTag uses NFC to pair, read, and update digital baggage tags."
      }
    },
    "android": {
      "package": "com.polyaero.smarttag",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#005D63"
      },
      "permissions": ["android.permission.NFC"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Cathay Sans EN",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/cathay/CathaySans_WCorp_Lt.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/cathay/CathaySans_WCorp_Rg.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/cathay/CathaySans_WCorp_Bd.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "GT Walsheim",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/cathay/GT-Walsheim-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/cathay/GT-Walsheim-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/cathay/GT-Walsheim-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/cathay/CathaySans_WCorp_Lt.ttf",
              "./assets/fonts/cathay/CathaySans_WCorp_Rg.ttf",
              "./assets/fonts/cathay/CathaySans_WCorp_Bd.ttf",
              "./assets/fonts/cathay/GT-Walsheim-Light.ttf",
              "./assets/fonts/cathay/GT-Walsheim-Regular.ttf",
              "./assets/fonts/cathay/GT-Walsheim-Bold.ttf"
            ]
          }
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "selectIdentifiers": ["D2760000850101"]
        }
      ],
      "./plugins/withNfcFeature"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "prototypeNotice": "PolyAero Cathay SmartTag Hackathon Concept - Unofficial Research Prototype"
    }
  }
}
