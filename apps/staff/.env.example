# Copy to .env.local in this directory. Next.js bundles NEXT_PUBLIC_* in the browser.
# Full FastAPI prefix is required. This override keeps local tests off the hosted demo.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Hosted hackathon API alternative:
# NEXT_PUBLIC_API_URL=https://smarttag-demo-4pu4shawla-df.a.run.app/api/v1
# Restart Next.js after editing; rebuild production bundles after changing the URL.
# Never put database credentials or staff/device secrets in NEXT_PUBLIC_*.
