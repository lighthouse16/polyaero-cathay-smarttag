# Backend API base, including /api/v1. Public URL only, never credentials.
STAFF_LIVE_BACKEND=0
NEXT_PUBLIC_API_URL=https://your-backend.example/api/v1

# Optional OpenAI-compatible provider / 9router (server-only).
# LLM_API_URL=https://your-authenticated-gateway.example/v1
# LLM_API_KEY=
# LLM_MODEL=ag/gemini-3.8-flash-high

# Alternative providers: configure only one.
# COPILOT_API_URL=https://your-backend.example/api/v1/copilot/chat
# COPILOT_API_KEY=
# OLLAMA_API_KEY=
# OLLAMA_MODEL=glm-5.3-flash
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
