# Copy to .env.local in this directory. Next.js bundles NEXT_PUBLIC_* in the browser.
# Full FastAPI prefix is required. This override keeps local tests off the hosted demo.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Use live PostgreSQL-backed transfer/performance/actions instead of local fixtures.
STAFF_LIVE_BACKEND=1
# Hosted hackathon API alternative:
# NEXT_PUBLIC_API_URL=https://smarttag-demo-4pu4shawla-df.a.run.app/api/v1
# Restart Next.js after editing; rebuild production bundles after changing the URL.
# Never put database credentials or staff/device secrets in NEXT_PUBLIC_*.
# Optional OpenAI-compatible provider / 9router (server-only).
# LLM_API_URL=https://your-authenticated-gateway.example/v1
# LLM_API_KEY=
# LLM_MODEL=ag/gemini-3.8-flash-high

# Alternative providers: configure only one.
# COPILOT_API_URL=https://your-backend.example/api/v1/copilot/chat
# COPILOT_API_KEY=
# OLLAMA_API_KEY=
# OLLAMA_MODEL=glm-5.3-flash
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
